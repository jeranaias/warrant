# Copy to .env (gitignored) and fill in. Sandbox / testnet values ONLY. Never commit .env.

# Airwallex sandbox (dashboard: https://www.sandbox.airwallex.com/app)
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# Metal testnet (x402). Chain eip155:63825.
METAL_ENV=testnet
# Your private RPC endpoint from https://console-testnet.metalntwx.com/endpoints
METAL_RPC_URL=
# Optional Basic-auth secret for that endpoint (the RPC also works without it)
METAL_RPC_SECRET=
METAL_FAUCET_URL=https://faucet.metalntwx.com
# Leave empty to use the facilitator built into @metalntwx/metal-pay (METAL_NETWORKS.testnet)
METAL_FACILITATOR_URL=
# Folder OUTSIDE the repo holding owner keys, mandate credentials and mandate keys.
# Only packages/rails reads it. Never give an agent anything from it.
METAL_HOME=
# Our store's Metal address (payTo on GET /query); public, not a secret
METAL_STORE_ADDRESS=
# Public: the simulated upstream provider's account (sourcing's payee). pnpm setup:testnet writes
# it, with the other public addresses, to METAL_HOME/warrant-public.env, which the engine reads.
METAL_UPSTREAM_ADDRESS=
# Optional. Default: METAL_HOME/cli/node_modules/@metalntwx/metal-agent/dist/index.js, run under node
METAL_AGENT_BIN=
# Optional. Live owner state + stored orders, outside the repo. Default: METAL_HOME/warrant-live
WARRANT_DATA_DIR=

# Model access for agents and the purpose checker. pnpm engine, pnpm agents and pnpm bench read it
# from here; never type it into a command. pnpm check:secrets fails if a key is ever committed.
ANTHROPIC_API_KEY=
# Keep the script and the deterministic check even with a key set: AGENT_BRAIN=scripted,
# PURPOSE_CHECK=deterministic. Spending stops per run (model calls): AGENT_MAX_CALLS (default 100;
# 2000 in pnpm bench), PURPOSE_MAX_CALLS (default 200; 2000 in pnpm bench).
AGENT_BRAIN=
PURPOSE_CHECK=
AGENT_MAX_CALLS=
PURPOSE_MAX_CALLS=

# Owner warrant-signing key (local dev key only)
WARRANT_OWNER_SIGNING_KEY=

# Point rails at local mocks instead of sandbox: mock | sandbox
RAILS_MODE=mock
MOCK_AIRWALLEX_PORT=4010
MOCK_METAL_PORT=4020
STORE_PORT=4021
# Warrant pass (ADR-012): 1 = serve only buyers with a valid x-warrant-pass. Default: 1 in sandbox, 0 in mock
STORE_REQUIRE_PASS=
# Our store's URL as buyers see it, if not the Host header (e.g. a tunnel)
STORE_PUBLIC_ORIGIN=
UPSTREAM_PORT=4022
