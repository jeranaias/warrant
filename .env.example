# Copy to .env (gitignored) and fill in. Sandbox / testnet values ONLY. Never commit .env.

# Airwallex sandbox (dashboard: https://www.sandbox.airwallex.com/app)
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# Metal testnet (x402)
METAL_ENV=testnet
METAL_API_KEY=
METAL_PAYER_WALLET_ID=

# Model access for agents and the purpose checker
ANTHROPIC_API_KEY=

# Owner warrant-signing key (local dev key only)
WARRANT_OWNER_SIGNING_KEY=

# Point rails at local mocks instead of sandbox: mock | sandbox
RAILS_MODE=mock
MOCK_AIRWALLEX_PORT=4010
MOCK_METAL_PORT=4020
