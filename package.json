{
  "name": "warrant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "pnpm check:secrets && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "mocks": "pnpm --filter @warrant/mocks dev",
    "engine": "pnpm --filter @warrant/engine dev",
    "scene": "pnpm --filter @warrant/engine scene",
    "scene:earnings": "pnpm --filter @warrant/engine scene:earnings",
    "scene:dispute": "pnpm --filter @warrant/engine scene:dispute",
    "scene:card": "pnpm --filter @warrant/engine scene:card",
    "setup:testnet": "pnpm --filter @warrant/engine setup:testnet",
    "reset:live": "pnpm --filter @warrant/engine reset:live",
    "dashboard": "pnpm --filter @warrant/dashboard dev",
    "store": "pnpm --filter @warrant/store dev",
    "agents": "pnpm --filter @warrant/agents start",
    "bench": "pnpm --filter @warrant/bench start",
    "build:hosted": "pnpm --filter @warrant/dashboard build --mode hosted && pnpm --filter @warrant/engine build:hosted",
    "start:hosted": "node apps/engine/dist/hosted.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
